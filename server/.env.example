# Server
PORT=3000
NODE_ENV=development
# Origines autorisées (séparées par des virgules). Vide = toutes en développement ; OBLIGATOIRE en production.
CORS_ORIGIN=http://localhost:5500
# Proxy inverse devant l'API : nombre de proxys de confiance (ex. 1 chez un hébergeur), "loopback" ou plage CIDR.
# Vide = aucun (accès direct). À renseigner derrière un proxy, sinon toutes les requêtes semblent venir de la même IP.
TRUST_PROXY=

# Database (Supabase)
# Pooler transactionnel : utilisé par l'application
DATABASE_URL=
# Pooler session : utilisé par la CLI Prisma (migrations)
DIRECT_URL=

# JWT (en production : 32 caractères minimum, ex. openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Premier Super Admin (utilisé uniquement par "npm run seed")
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Stockage de fichiers (Cloudinary) : tableau de bord -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Racine des fichiers : EVC en production, EVC-dev sinon (valeur par défaut)
STORAGE_ROOT=

# Fuseau horaire de l'église : définit où commence et finit un jour (fin automatique des événements)
APP_TIMEZONE=Africa/Kinshasa
# Publication programmée (événements, actualités) : false pour désactiver la tâche de fond
SCHEDULER_ENABLED=true

# Notifications (voir docs/NOTIFICATIONS.md)
# Fournisseur : onesignal | fake | none. Sans clés OneSignal, « none » : les notifications sont planifiées mais PAS envoyées.
NOTIFICATIONS_PROVIDER=
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
# Préfixe des liens ouverts au toucher d'une notification (ex. https://eglisevieceleste.org)
PUBLIC_SITE_URL=
# Heure d'envoi de la notification du message du jour (heure de l'église) et âge maximal d'une notification en retard
DAILY_MESSAGE_NOTIFY_TIME=07:00
NOTIFICATION_MAX_AGE_HOURS=24
# Segments OneSignal des audiences (valeurs par défaut ci-dessous)
# ONESIGNAL_SEGMENT_ALL=Total Subscriptions
# ONESIGNAL_SEGMENT_ADMINS=Admins
# ONESIGNAL_SEGMENT_MEMBERS=Members
# ONESIGNAL_SEGMENT_VISITORS=Visitors
