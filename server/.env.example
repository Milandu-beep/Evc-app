# Server
PORT=3000
NODE_ENV=development
# Origines autorisées (séparées par des virgules). Vide = toutes.
CORS_ORIGIN=http://localhost:5500

# Database (Supabase)
# Pooler transactionnel : utilisé par l'application
DATABASE_URL=
# Pooler session : utilisé par la CLI Prisma (migrations)
DIRECT_URL=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Premier Super Admin (utilisé uniquement par "npm run seed")
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Stockage de fichiers (Cloudinary) : tableau de bord -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Racine des fichiers : EVC en production, EVC-dev sinon (valeur par défaut)
STORAGE_ROOT=
