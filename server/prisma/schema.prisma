// =============================================================================
// EVC APP — Schéma de données (Sprint 2)
//
// Conventions
//  - Tables en snake_case pluriel (@@map), modèles en PascalCase.
//  - Contenu public multilingue (charte §9) : une table parente (données
//    indépendantes de la langue) + une table *Translation (une ligne par langue).
//  - Statut éditorial commun : PublishStatus (DRAFT / PUBLISHED / ARCHIVED).
//  - Suppression : les traductions suivent leur parent (Cascade) ; les liens vers
//    Admin sont SetNull pour ne jamais perdre un contenu si un compte est supprimé.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

// Rôles de la charte (§4)
enum Role {
  SUPER_ADMIN
  ADMIN
}

// Langues de la charte (§9). Valeurs identiques à LANGUAGES dans config/constants.js.
enum Language {
  fr
  en
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Formats de la médiathèque (charte §10)
enum MediaType {
  IMAGE
  PDF
  AUDIO
  YOUTUBE
}

enum NotificationType {
  GENERAL
  EVENT
  NEWS
  DAILY_MESSAGE
}

// Jour de la semaine (horaires de culte)
enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// Actions tracées dans le journal d'audit
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
}

enum NotificationStatus {
  DRAFT
  SCHEDULED
  SENT
  FAILED
}

// ----------------------------------------------------------------------------
// Utilisateurs
// ----------------------------------------------------------------------------

// Comptes d'administration (Super Admin et Admin). Pas d'inscription publique.
model Admin {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String    @unique
  password  String
  firstName String
  lastName  String
  role      Role      @default(ADMIN)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  updatedAt DateTime  @updatedAt

  events        Event[]
  news          News[]
  dailyMessages DailyMessage[]
  notifications Notification[]
  media         Media[]
  auditLogs     AuditLog[]

  @@map("admins")
}

// ----------------------------------------------------------------------------
// Événements
// ----------------------------------------------------------------------------

model Event {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status      PublishStatus @default(DRAFT)
  coverImage  String? // URL Supabase Storage
  startsAt    DateTime
  endsAt      DateTime?
  isFeatured  Boolean       @default(false)
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now())
  deletedAt   DateTime?
  updatedAt   DateTime      @updatedAt

  createdBy     Admin?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  translations  EventTranslation[]
  notifications Notification[]

  @@index([status, startsAt, deletedAt])
  @@index([isFeatured])
  @@index([createdById])
  @@map("events")
}

model EventTranslation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String   @db.Uuid
  language    Language
  slug        String
  title       String
  description String
  location    String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, language])
  @@unique([language, slug])
  @@map("event_translations")
}

// ----------------------------------------------------------------------------
// Actualités
// ----------------------------------------------------------------------------

model News {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status      PublishStatus @default(DRAFT)
  coverImage  String?
  publishedAt DateTime? // renseignée à la publication
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now())
  deletedAt   DateTime?
  updatedAt   DateTime      @updatedAt

  createdBy     Admin?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  translations  NewsTranslation[]
  notifications Notification[]

  @@index([status, publishedAt, deletedAt])
  @@index([createdById])
  @@map("news")
}

model NewsTranslation {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  newsId   String   @db.Uuid
  language Language
  slug     String
  title    String
  excerpt  String?
  content  String

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([newsId, language])
  @@unique([language, slug])
  @@map("news_translations")
}

// ----------------------------------------------------------------------------
// Messages quotidiens (un par jour)
// ----------------------------------------------------------------------------

model DailyMessage {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date        DateTime      @db.Date
  status      PublishStatus @default(DRAFT)
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now())
  deletedAt   DateTime?
  updatedAt   DateTime      @updatedAt

  createdBy     Admin?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  translations  DailyMessageTranslation[]
  notifications Notification[]

  // Unicité (date) WHERE deletedAt IS NULL : voir migration SQL (index partiel)
  @@index([date])
  @@index([status, date, deletedAt])
  @@index([createdById])
  @@map("daily_messages")
}

model DailyMessageTranslation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dailyMessageId String   @db.Uuid
  language       Language
  title          String
  content        String
  bibleReference String? // ex. « Jean 3:16 »

  dailyMessage DailyMessage @relation(fields: [dailyMessageId], references: [id], onDelete: Cascade)

  @@unique([dailyMessageId, language])
  @@map("daily_message_translations")
}

// ----------------------------------------------------------------------------
// Notifications (envoi via OneSignal)
// ----------------------------------------------------------------------------

model Notification {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           NotificationType   @default(GENERAL)
  status         NotificationStatus @default(DRAFT)
  scheduledAt    DateTime?
  sentAt         DateTime?
  oneSignalId    String? // identifiant retourné par OneSignal après envoi
  errorMessage   String?
  // Contenu associé (facultatif) : permet d'ouvrir la bonne page depuis la notification
  eventId        String?            @db.Uuid
  newsId         String?            @db.Uuid
  dailyMessageId String?            @db.Uuid
  createdById    String?            @db.Uuid
  createdAt      DateTime           @default(now())
  deletedAt      DateTime?
  updatedAt      DateTime           @updatedAt

  createdBy    Admin?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  event        Event?                    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  news         News?                     @relation(fields: [newsId], references: [id], onDelete: SetNull)
  dailyMessage DailyMessage?             @relation(fields: [dailyMessageId], references: [id], onDelete: SetNull)
  translations NotificationTranslation[]

  @@index([status, scheduledAt, deletedAt])
  @@index([createdById])
  @@index([eventId])
  @@index([newsId])
  @@index([dailyMessageId])
  @@map("notifications")
}

model NotificationTranslation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String   @db.Uuid
  language       Language
  title          String
  message        String

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, language])
  @@map("notification_translations")
}

// ----------------------------------------------------------------------------
// Médiathèque : images, PDF, MP3 (Supabase Storage) et vidéos YouTube
// ----------------------------------------------------------------------------

model Media {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type         MediaType
  status       PublishStatus @default(DRAFT)
  // Fichier stocké (IMAGE / PDF / AUDIO) : chemin dans le bucket + URL publique
  storagePath  String?
  url          String? // URL publique du fichier, ou URL YouTube pour type YOUTUBE
  youtubeId    String? // identifiant de la vidéo (type YOUTUBE)
  mimeType     String?
  sizeBytes    Int?
  uploadedById String?       @db.Uuid
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?
  updatedAt    DateTime      @updatedAt

  uploadedBy   Admin?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  translations MediaTranslation[]

  @@index([type, status, createdAt, deletedAt])
  @@index([uploadedById])
  @@map("media")
}

model MediaTranslation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mediaId     String   @db.Uuid
  language    Language
  title       String
  description String?

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, language])
  @@map("media_translations")
}

// ----------------------------------------------------------------------------
// Paramètres de l'église (une seule ligne, id = 1) et horaires
// ----------------------------------------------------------------------------

model ChurchSetting {
  id          Int      @id @default(1)
  name        String   @default("Église Vie Céleste")
  email       String?
  phone       String?
  whatsapp    String?
  facebookUrl String?
  youtubeUrl  String?
  tiktokUrl   String?
  updatedAt   DateTime @updatedAt

  translations ChurchSettingTranslation[]

  @@map("church_settings")
}

model ChurchSettingTranslation {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settingId        Int
  language         Language
  slogan           String?
  mission          String?
  address          String?
  addressReference String? // repères (croisement d'avenues, point de repère…)

  setting ChurchSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)

  @@unique([settingId, language])
  @@map("church_setting_translations")
}

// Horaires de culte.
// startTime / endTime au format "HH:mm" (validé par l'application).
model ServiceSchedule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dayOfWeek Weekday
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations ServiceScheduleTranslation[]

  @@index([dayOfWeek, startTime])
  @@map("service_schedules")
}

model ServiceScheduleTranslation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleId String   @db.Uuid
  language   Language
  label      String // ex. « Culte du dimanche »

  schedule ServiceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, language])
  @@map("service_schedule_translations")
}

// ----------------------------------------------------------------------------
// Formulaire de contact (page publique « Contact »)
// ----------------------------------------------------------------------------

model ContactMessage {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  email     String
  subject   String?
  message   String
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([isRead, createdAt, deletedAt])
  @@map("contact_messages")
}

// ----------------------------------------------------------------------------
// Journal d'audit : qui a fait quoi, sur quelle ressource (jamais modifié par le code)
// ----------------------------------------------------------------------------

model AuditLog {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId   String?     @db.Uuid
  action    AuditAction
  entity    String // nom de la table concernée, ex. "events"
  entityId  String? // identifiant de la ressource (UUID)
  changes   Json? // résumé des champs modifiés (jamais de mot de passe)
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([adminId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
