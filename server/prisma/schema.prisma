generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Rôles de la charte (section 4)
enum Role {
  SUPER_ADMIN
  ADMIN
}

// Comptes d'administration (Super Admin et Admin). Pas d'inscription publique.
model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      Role     @default(ADMIN)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}
