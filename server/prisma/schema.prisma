// =============================================================================
// EVC APP — Schéma de données (Sprint 2)
//
// Conventions
//  - Tables en snake_case pluriel (@@map), modèles en PascalCase.
//  - Contenu public multilingue (charte §9) : une table parente (données
//    indépendantes de la langue) + une table *Translation (une ligne par langue).
//  - Statut éditorial commun : PublishStatus (DRAFT / PUBLISHED / ARCHIVED).
//  - Suppression : les traductions suivent leur parent (Cascade) ; les liens vers
//    Admin sont SetNull pour ne jamais perdre un contenu si un compte est supprimé.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

// Rôles de la charte (§4)
enum Role {
  SUPER_ADMIN
  ADMIN
}

// Langues de la charte (§9). Valeurs identiques à LANGUAGES dans config/constants.js.
enum Language {
  fr
  en
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Formats de la médiathèque (charte §10)
enum MediaType {
  IMAGE
  PDF
  AUDIO
  YOUTUBE
  VIDEO
}

enum NotificationType {
  GENERAL
  EVENT
  NEWS
  DAILY_MESSAGE
  SERMON
  TEST
}

// Cycle de vie d'un événement. « Terminé » n'est pas stocké : il se déduit des dates
// (statut PUBLISHED et date de fin dépassée), voir services/events/event.state.js.
enum EventStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  CANCELLED
  ARCHIVED
}

// Nature d'un événement (filtre, couleur et icône par défaut côté frontend)
enum EventType {
  SERVICE
  CONFERENCE
  SEMINAR
  RETREAT
  YOUTH
  PRAYER
  EVANGELISM
  OTHER
}

// Cycle de vie d'une actualité (même logique que les événements, sans annulation ni « terminé »)
enum NewsStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

// Cycle de vie d'un message du jour (même logique que les actualités)
enum DailyMessageStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

// Nature d'un média de galerie (déduite du fichier : image -> PHOTO, vidéo hébergée -> VIDEO)
enum GalleryItemType {
  PHOTO
  VIDEO
}

// Catégories d'une personne (une personne peut en cumuler plusieurs : pasteur ET prédicateur)
enum PersonCategory {
  PASTOR
  TEAM
  SPEAKER
  LEADER
  OTHER
}

// Rôle d'un intervenant dans une prédication (une prédication peut en avoir plusieurs)
enum SpeakerRole {
  PREACHER
  GUEST_PREACHER
  TRANSLATOR
  WORSHIP_LEADER
  MODERATOR
  PRAYER
  OTHER
}

// Cycle de vie d'une prédication (même logique que les actualités)
enum SermonStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

// Fournisseur de stockage des fichiers (voir docs/STORAGE_ARCHITECTURE.md)
enum StorageProvider {
  CLOUDINARY
  R2
}

// Cycle de vie d'un fichier : UPLOADING (ligne créée, envoi en cours) -> READY (utilisable)
// ou FAILED (envoi interrompu ou échoué). DELETED = marqué par le nettoyage (deletedAt posé).
enum StorageFileStatus {
  UPLOADING
  READY
  FAILED
  DELETED
}

// Type de ressource chez le fournisseur (Cloudinary : image / video / raw ; l'audio est « video »)
enum StorageResourceType {
  IMAGE
  VIDEO
  RAW
}

// Jour de la semaine (horaires de culte)
enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// Actions tracées dans le journal d'audit
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  UPLOAD_FILE
  DELETE_FILE
  STATUS_CHANGE
}

// Cycle de vie d'une notification : DRAFT -> SCHEDULED -> SENDING -> SENT, ou FAILED (échecs épuisés) ou CANCELLED
enum NotificationStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

// Catégories de destinataires. Le fournisseur les traduit en segments (voir docs/NOTIFICATIONS.md).
enum NotificationAudience {
  ALL
  ADMINS
  MEMBERS
  VISITORS
}

// Événements de l'historique d'une notification
enum NotificationLogEvent {
  CREATED
  SCHEDULED
  RESCHEDULED
  SENDING
  SENT
  RETRY
  FAILED
  CANCELLED
}

// ----------------------------------------------------------------------------
// Utilisateurs
// ----------------------------------------------------------------------------

// Comptes d'administration (Super Admin et Admin). Pas d'inscription publique.
model Admin {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String    @unique
  password  String
  firstName String
  lastName  String
  role      Role      @default(ADMIN)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  updatedAt DateTime  @updatedAt

  events           Event[]
  news             News[]
  dailyMessages    DailyMessage[]
  notifications    Notification[]
  media            Media[]
  auditLogs        AuditLog[]
  storageFiles     StorageFile[]
  galleryAlbums    GalleryAlbum[]
  galleryItems     GalleryItem[]
  people           Person[]
  sermonSeries     SermonSeries[]
  sermons          Sermon[]
  notificationLogs NotificationLog[]

  @@map("admins")
}

// ----------------------------------------------------------------------------
// Événements
// ----------------------------------------------------------------------------

model Event {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                 EventType   @default(OTHER)
  // Présentation (calendrier) : couleur #RRGGBB et nom d'icône, facultatifs
  color                String?
  icon                 String?
  status               EventStatus @default(DRAFT)
  coverImageId         String?     @db.Uuid
  startsAt             DateTime
  endsAt               DateTime?
  isFeatured           Boolean     @default(false)
  // Publication programmée : visible publiquement à partir de publishAt (statut SCHEDULED)
  publishAt            DateTime?
  publishedAt          DateTime? // première publication effective
  cancelledAt          DateTime?
  // Inscription (événements futurs nécessitant une inscription)
  registrationRequired Boolean     @default(false)
  registrationUrl      String?
  // Capacité : null = illimitée. registeredCount est tenu à jour par le futur module d'inscription
  // (jamais modifiable par l'API d'administration des événements).
  capacity             Int?
  registeredCount      Int         @default(0)
  // Préparation OneSignal (Sprint notifications) : demande d'une notification à la publication
  notifyOnPublish      Boolean     @default(false)
  createdById          String?     @db.Uuid
  createdAt            DateTime    @default(now())
  deletedAt            DateTime?
  updatedAt            DateTime    @updatedAt

  coverImage    StorageFile?       @relation(fields: [coverImageId], references: [id], onDelete: SetNull)
  createdBy     Admin?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  translations  EventTranslation[]
  notifications Notification[]
  galleryAlbums GalleryAlbum[]

  @@index([status, startsAt, deletedAt])
  @@index([status, publishAt])
  @@index([isFeatured])
  @@index([type])
  @@index([createdById])
  @@index([coverImageId])
  @@map("events")
}

model EventTranslation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String   @db.Uuid
  language    Language
  slug        String
  title       String
  description String
  location    String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, language])
  @@unique([language, slug])
  @@map("event_translations")
}

// ----------------------------------------------------------------------------
// Actualités
// ----------------------------------------------------------------------------

model News {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status          NewsStatus @default(DRAFT)
  coverImageId    String?    @db.Uuid
  publishedAt     DateTime? // renseignée à la publication
  // Publication programmée : visible publiquement à partir de publishAt (statut SCHEDULED)
  publishAt       DateTime?
  isFeatured      Boolean    @default(false)
  // Préparation OneSignal : demande d'une notification à la publication
  notifyOnPublish Boolean    @default(false)
  createdById     String?    @db.Uuid
  createdAt       DateTime   @default(now())
  deletedAt       DateTime?
  updatedAt       DateTime   @updatedAt

  coverImage    StorageFile?      @relation(fields: [coverImageId], references: [id], onDelete: SetNull)
  createdBy     Admin?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  translations  NewsTranslation[]
  notifications Notification[]

  @@index([status, publishedAt, deletedAt])
  @@index([status, publishAt])
  @@index([isFeatured])
  @@index([createdById])
  @@index([coverImageId])
  @@map("news")
}

model NewsTranslation {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  newsId   String   @db.Uuid
  language Language
  slug     String
  title    String
  excerpt  String?
  content  String

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([newsId, language])
  @@unique([language, slug])
  @@map("news_translations")
}

// ----------------------------------------------------------------------------
// Messages quotidiens (un par jour)
// ----------------------------------------------------------------------------

model DailyMessage {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date             DateTime           @db.Date
  status           DailyMessageStatus @default(DRAFT)
  imageId          String?            @db.Uuid
  // Publication programmée : le message devient publiable à partir de publishAt (statut SCHEDULED).
  // Il n'est affiché qu'à partir de sa date (« date »), même s'il est publié plus tôt.
  publishAt        DateTime?
  publishedAt      DateTime?
  // Préparation OneSignal : le module de notifications enverra le titre et le texte de notification
  // (par langue) le jour du message si sendNotification est vrai.
  sendNotification Boolean            @default(false)
  createdById      String?            @db.Uuid
  createdAt        DateTime           @default(now())
  deletedAt        DateTime?
  updatedAt        DateTime           @updatedAt

  image         StorageFile?              @relation(fields: [imageId], references: [id], onDelete: SetNull)
  createdBy     Admin?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  translations  DailyMessageTranslation[]
  notifications Notification[]

  // Unicité (date) WHERE deletedAt IS NULL : voir migration SQL (index partiel)
  @@index([date])
  @@index([status, date, deletedAt])
  @@index([status, publishAt])
  @@index([createdById])
  @@index([imageId])
  @@map("daily_messages")
}

model DailyMessageTranslation {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dailyMessageId       String   @db.Uuid
  language             Language
  title                String
  content              String
  verseReference       String? // ex. « Jean 3:16 »
  verseText            String? // texte du verset
  theme                String? // ex. « Espérance »
  // Temps de lecture en minutes (au moins 1) : CALCULÉ par l'application, jamais saisi
  estimatedReadingTime Int      @default(1)
  // Notification push (facultatifs) : à défaut, le module de notifications utilisera le titre et un extrait
  notificationTitle    String?
  notificationBody     String?

  dailyMessage DailyMessage @relation(fields: [dailyMessageId], references: [id], onDelete: Cascade)

  @@unique([dailyMessageId, language])
  @@index([language, theme])
  @@map("daily_message_translations")
}

// ----------------------------------------------------------------------------
// Notifications (envoi via OneSignal)
// ----------------------------------------------------------------------------

model Notification {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type              NotificationType     @default(GENERAL)
  audience          NotificationAudience @default(ALL)
  status            NotificationStatus   @default(DRAFT)
  scheduledAt       DateTime?
  sentAt            DateTime?
  provider          String? // fournisseur qui a envoyé (« onesignal », « fake »…)
  providerMessageId String? // identifiant du message chez le fournisseur
  recipients        Int? // destinataires atteints, si le fournisseur le dit
  errorMessage      String?
  // Contenu associé (facultatif) : permet d'ouvrir la bonne page depuis la notification
  eventId           String?              @db.Uuid
  newsId            String?              @db.Uuid
  dailyMessageId    String?              @db.Uuid
  sermonId          String?              @db.Uuid
  attempts          Int                  @default(0)
  lastAttemptAt     DateTime?
  // Une seule notification automatique par contenu et par type d'événement (ex. « event.published:<id> »)
  dedupeKey         String?              @unique
  createdById       String?              @db.Uuid
  createdAt         DateTime             @default(now())
  deletedAt         DateTime?
  updatedAt         DateTime             @updatedAt

  createdBy    Admin?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  event        Event?                    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  news         News?                     @relation(fields: [newsId], references: [id], onDelete: SetNull)
  dailyMessage DailyMessage?             @relation(fields: [dailyMessageId], references: [id], onDelete: SetNull)
  sermon       Sermon?                   @relation(fields: [sermonId], references: [id], onDelete: SetNull)
  logs         NotificationLog[]
  translations NotificationTranslation[]

  @@index([status, scheduledAt, deletedAt])
  @@index([createdById])
  @@index([eventId])
  @@index([newsId])
  @@index([dailyMessageId])
  @@index([sermonId])
  @@index([status, scheduledAt])
  @@map("notifications")
}

model NotificationTranslation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String   @db.Uuid
  language       Language
  title          String
  message        String
  url            String? // chemin ouvert au toucher (ex. « /events/soiree-de-louange »), propre à la langue

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, language])
  @@map("notification_translations")
}

// ----------------------------------------------------------------------------
// Médiathèque : images, PDF, MP3 (Supabase Storage) et vidéos YouTube
// ----------------------------------------------------------------------------

model Media {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          MediaType
  status        PublishStatus @default(DRAFT)
  // Fichier hébergé (IMAGE / PDF / AUDIO / VIDEO) : voir storage_files. Vide pour YOUTUBE.
  storageFileId String?       @db.Uuid
  folderId      String?       @db.Uuid
  url           String? // lien YouTube (type YOUTUBE uniquement)
  youtubeId     String? // identifiant de la vidéo (type YOUTUBE)
  uploadedById  String?       @db.Uuid
  createdAt     DateTime      @default(now())
  deletedAt     DateTime?
  updatedAt     DateTime      @updatedAt

  storageFile  StorageFile?       @relation(fields: [storageFileId], references: [id], onDelete: SetNull)
  folder       MediaFolder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy   Admin?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  translations MediaTranslation[]

  @@index([type, status, createdAt, deletedAt])
  @@index([uploadedById])
  @@index([storageFileId])
  @@index([folderId])
  @@map("media")
}

model MediaTranslation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mediaId     String   @db.Uuid
  language    Language
  title       String
  description String?

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, language])
  @@map("media_translations")
}

// ----------------------------------------------------------------------------
// Paramètres de l'église (une seule ligne, id = 1) et horaires
// ----------------------------------------------------------------------------

model ChurchSetting {
  id          Int      @id @default(1)
  name        String   @default("Église Vie Céleste")
  email       String?
  phone       String?
  whatsapp    String?
  facebookUrl String?
  youtubeUrl  String?
  tiktokUrl   String?
  logoId      String?  @db.Uuid
  updatedAt   DateTime @updatedAt

  logo         StorageFile?               @relation(fields: [logoId], references: [id], onDelete: SetNull)
  translations ChurchSettingTranslation[]

  @@map("church_settings")
}

model ChurchSettingTranslation {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settingId        Int
  language         Language
  slogan           String?
  mission          String?
  address          String?
  addressReference String? // repères (croisement d'avenues, point de repère…)

  setting ChurchSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)

  @@unique([settingId, language])
  @@map("church_setting_translations")
}

// Horaires de culte.
// startTime / endTime au format "HH:mm" (validé par l'application).
model ServiceSchedule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dayOfWeek Weekday
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations ServiceScheduleTranslation[]

  @@index([dayOfWeek, startTime])
  @@map("service_schedules")
}

model ServiceScheduleTranslation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleId String   @db.Uuid
  language   Language
  label      String // ex. « Culte du dimanche »

  schedule ServiceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, language])
  @@map("service_schedule_translations")
}

// ----------------------------------------------------------------------------
// Formulaire de contact (page publique « Contact »)
// ----------------------------------------------------------------------------

model ContactMessage {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  email     String
  subject   String?
  message   String
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([isRead, createdAt, deletedAt])
  @@map("contact_messages")
}

// ----------------------------------------------------------------------------
// Journal d'audit : qui a fait quoi, sur quelle ressource (jamais modifié par le code)
// ----------------------------------------------------------------------------

model AuditLog {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId   String?     @db.Uuid
  action    AuditAction
  entity    String // nom de la table concernée, ex. "events"
  entityId  String? // identifiant de la ressource (UUID)
  changes   Json? // résumé des champs modifiés (jamais de mot de passe)
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([adminId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ----------------------------------------------------------------------------
// Stockage de fichiers (Cloudinary) : une ligne par fichier, partagée entre contenus.
// Le fichier n'est jamais dans la base : seulement ses métadonnées.
// ----------------------------------------------------------------------------

model StorageFile {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider         StorageProvider
  status           StorageFileStatus   @default(UPLOADING)
  publicId         String // identifiant chez le fournisseur : sert à supprimer et à construire les URLs
  resourceType     StorageResourceType
  url              String? // URL telle que renvoyée par le fournisseur (instantané)
  secureUrl        String? // URL HTTPS telle que renvoyée par le fournisseur (instantané)
  folder           String // dossier logique, ex. « events/covers » (voir config/storage.js)
  originalFilename String // nom d'origine, ex. « Guide Baptême.pdf »
  mimeType         String
  bytes            Int
  width            Int?
  height           Int?
  duration         Float? // secondes (vidéo, audio)
  checksum         String // SHA-256 hexadécimal du fichier envoyé
  createdById      String?             @db.Uuid
  createdAt        DateTime            @default(now())
  deletedAt        DateTime?

  createdBy       Admin?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  events          Event[]
  news            News[]
  dailyMessages   DailyMessage[]
  churchSettings  ChurchSetting[]
  media           Media[]
  galleryCovers   GalleryAlbum[]
  galleryItems    GalleryItem[]
  peoplePhotos    Person[]
  seriesCovers    SermonSeries[]
  sermonCovers    Sermon[]         @relation("SermonCover")
  sermonAudios    Sermon[]         @relation("SermonAudio")
  sermonVideos    Sermon[]         @relation("SermonVideo")
  sermonDocuments SermonDocument[]

  @@unique([provider, resourceType, publicId])
  @@index([checksum])
  @@index([folder])
  @@index([deletedAt])
  @@index([status, createdAt])
  @@index([createdById])
  @@map("storage_files")
}

// Dossiers visibles dans la médiathèque (Baptêmes, Séminaires…) : étiquettes en base,
// distinctes de l'arborescence technique du stockage.
model MediaFolder {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  parentId  String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  parent   MediaFolder?  @relation("MediaFolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children MediaFolder[] @relation("MediaFolderTree")
  media    Media[]

  // Unicité (parent, nom) parmi les lignes actives : index partiel dans la migration SQL
  @@index([parentId, name])
  @@index([parentId])
  @@map("media_folders")
}

// ----------------------------------------------------------------------------
// Galerie : albums (FR/EN, slug, couverture, événement lié) contenant des médias
// (photos ou vidéos hébergées, avec tags, texte alternatif et ordre).
// Cycle de vie : brouillon / publié / archivé. Suppression logique des albums et des médias.
// ----------------------------------------------------------------------------

model GalleryAlbum {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status        PublishStatus @default(DRAFT)
  date          DateTime      @db.Date // date de l'album (ex. le jour de l'événement)
  isFeatured    Boolean       @default(false)
  sortOrder     Int           @default(0) // ordre d'affichage manuel (croissant)
  coverImageId  String?       @db.Uuid // sinon : premier média de l'album
  linkedEventId String?       @db.Uuid // événement lié (facultatif)
  publishedAt   DateTime?
  createdById   String?       @db.Uuid
  createdAt     DateTime      @default(now())
  deletedAt     DateTime?
  updatedAt     DateTime      @updatedAt

  coverImage   StorageFile?              @relation(fields: [coverImageId], references: [id], onDelete: SetNull)
  linkedEvent  Event?                    @relation(fields: [linkedEventId], references: [id], onDelete: SetNull)
  createdBy    Admin?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  translations GalleryAlbumTranslation[]
  items        GalleryItem[]

  @@index([status, date, deletedAt])
  @@index([isFeatured])
  @@index([sortOrder])
  @@index([linkedEventId])
  @@index([coverImageId])
  @@index([createdById])
  @@map("gallery_albums")
}

model GalleryAlbumTranslation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  albumId     String   @db.Uuid
  language    Language
  slug        String
  title       String
  description String?

  album GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([albumId, language])
  @@unique([language, slug])
  @@map("gallery_album_translations")
}

model GalleryItem {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  albumId       String          @db.Uuid
  storageFileId String          @db.Uuid
  type          GalleryItemType
  position      Int // ordre dans l'album (croissant) ; des trous sont possibles, l'ordre reste correct
  // Tags : minuscules, chiffres et tirets (ex. « bapteme »), au plus 20. Index GIN dans la migration SQL.
  tags          String[]        @default([])
  createdById   String?         @db.Uuid
  createdAt     DateTime        @default(now())
  deletedAt     DateTime?
  updatedAt     DateTime        @updatedAt

  album        GalleryAlbum             @relation(fields: [albumId], references: [id], onDelete: Cascade)
  storageFile  StorageFile              @relation(fields: [storageFileId], references: [id], onDelete: Restrict)
  createdBy    Admin?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  translations GalleryItemTranslation[]

  @@index([albumId, position, deletedAt])
  @@index([storageFileId])
  @@index([type])
  @@index([createdById])
  @@map("gallery_items")
}

model GalleryItemTranslation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId      String   @db.Uuid
  language    Language
  title       String?
  description String?
  altText     String? // texte alternatif (accessibilité)

  item GalleryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, language])
  @@map("gallery_item_translations")
}

// ----------------------------------------------------------------------------
// Personnes : table GÉNÉRIQUE réutilisable (page des pasteurs, équipe, intervenants, responsables…).
// Le nom n'est pas traduit ; le titre (« Pasteur principal ») et la biographie le sont.
// ----------------------------------------------------------------------------

model Person {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status      PublishStatus    @default(DRAFT) // visibilité de la FICHE publique (le nom reste affiché sur les prédications)
  firstName   String
  lastName    String
  slug        String           @unique // identifiant d'URL, généré depuis le nom
  categories  PersonCategory[] @default([])
  sortOrder   Int              @default(0)
  photoId     String?          @db.Uuid
  publishedAt DateTime?
  createdById String?          @db.Uuid
  createdAt   DateTime         @default(now())
  deletedAt   DateTime?
  updatedAt   DateTime         @updatedAt

  photo          StorageFile?        @relation(fields: [photoId], references: [id], onDelete: SetNull)
  createdBy      Admin?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  translations   PersonTranslation[]
  sermonSpeakers SermonSpeaker[]

  @@index([status, deletedAt])
  @@index([sortOrder])
  @@index([photoId])
  @@index([createdById])
  @@map("people")
}

model PersonTranslation {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId String   @db.Uuid
  language Language
  title    String? // ex. « Pasteur principal »
  bio      String?

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, language])
  @@map("person_translations")
}

// ----------------------------------------------------------------------------
// Séries de prédications
// ----------------------------------------------------------------------------

model SermonSeries {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status       PublishStatus @default(DRAFT)
  sortOrder    Int           @default(0)
  isFeatured   Boolean       @default(false)
  coverImageId String?       @db.Uuid
  publishedAt  DateTime?
  createdById  String?       @db.Uuid
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?
  updatedAt    DateTime      @updatedAt

  coverImage   StorageFile?              @relation(fields: [coverImageId], references: [id], onDelete: SetNull)
  createdBy    Admin?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  translations SermonSeriesTranslation[]
  sermons      Sermon[]

  @@index([status, deletedAt])
  @@index([sortOrder])
  @@index([isFeatured])
  @@index([coverImageId])
  @@index([createdById])
  @@map("sermon_series")
}

model SermonSeriesTranslation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seriesId    String   @db.Uuid
  language    Language
  slug        String
  title       String
  description String?

  series SermonSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, language])
  @@unique([language, slug])
  @@map("sermon_series_translations")
}

// ----------------------------------------------------------------------------
// Prédications : audio MP3, vidéo (hébergée ou lien YouTube), documents PDF, verset(s), tags, compteurs
// ----------------------------------------------------------------------------

model Sermon {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status          SermonStatus @default(DRAFT)
  date            DateTime     @db.Date // date de la prédication
  seriesId        String?      @db.Uuid
  seriesPosition  Int? // numéro dans la série (1, 2, 3…)
  coverImageId    String?      @db.Uuid
  audioFileId     String?      @db.Uuid // MP3 hébergé
  videoFileId     String?      @db.Uuid // vidéo hébergée (Cloudinary)
  youtubeId       String? // OU lien YouTube (identifiant de 11 caractères) : pas les deux
  isFeatured      Boolean      @default(false)
  notifyOnPublish Boolean      @default(false) // préparation OneSignal
  tags            String[]     @default([]) // minuscules, chiffres et tirets ; index GIN dans la migration
  publishAt       DateTime?
  publishedAt     DateTime?
  // Compteurs : modifiés uniquement par les routes publiques de comptage, jamais par l'administration
  viewCount       Int          @default(0)
  playCount       Int          @default(0)
  downloadCount   Int          @default(0)
  createdById     String?      @db.Uuid
  createdAt       DateTime     @default(now())
  deletedAt       DateTime?
  updatedAt       DateTime     @updatedAt

  series        SermonSeries?       @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  coverImage    StorageFile?        @relation("SermonCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  audioFile     StorageFile?        @relation("SermonAudio", fields: [audioFileId], references: [id], onDelete: SetNull)
  videoFile     StorageFile?        @relation("SermonVideo", fields: [videoFileId], references: [id], onDelete: SetNull)
  createdBy     Admin?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  translations  SermonTranslation[]
  speakers      SermonSpeaker[]
  documents     SermonDocument[]
  notifications Notification[]

  @@index([status, date, deletedAt])
  @@index([status, publishAt])
  @@index([seriesId, seriesPosition])
  @@index([isFeatured])
  @@index([playCount])
  @@index([coverImageId])
  @@index([audioFileId])
  @@index([videoFileId])
  @@index([createdById])
  @@map("sermons")
}

model SermonTranslation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sermonId        String   @db.Uuid
  language        Language
  slug            String
  title           String
  description     String?
  theme           String? // ex. « Espérance »
  verseReferences String[] @default([]) // ex. « Jean 3:16 », « Psaume 23 » (10 au plus)

  sermon Sermon @relation(fields: [sermonId], references: [id], onDelete: Cascade)

  @@unique([sermonId, language])
  @@unique([language, slug])
  @@index([language, theme])
  @@map("sermon_translations")
}

// Intervenants d'une prédication, avec leur rôle. L'interface actuelle n'en utilise qu'un (PREACHER) ;
// le modèle accepte plusieurs personnes et plusieurs rôles sans changement.
model SermonSpeaker {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sermonId String      @db.Uuid
  personId String      @db.Uuid
  role     SpeakerRole @default(PREACHER)
  position Int         @default(0)

  sermon Sermon @relation(fields: [sermonId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@unique([sermonId, personId, role])
  @@index([sermonId, position])
  @@index([personId])
  @@map("sermon_speakers")
}

// Documents PDF d'accompagnement (notes, plan…)
model SermonDocument {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sermonId      String   @db.Uuid
  storageFileId String   @db.Uuid
  position      Int      @default(0)
  createdAt     DateTime @default(now())

  sermon       Sermon                      @relation(fields: [sermonId], references: [id], onDelete: Cascade)
  storageFile  StorageFile                 @relation(fields: [storageFileId], references: [id], onDelete: Restrict)
  translations SermonDocumentTranslation[]

  @@unique([sermonId, storageFileId])
  @@index([sermonId, position])
  @@index([storageFileId])
  @@map("sermon_documents")
}

model SermonDocumentTranslation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String   @db.Uuid
  language   Language
  title      String

  document SermonDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, language])
  @@map("sermon_document_translations")
}

// ----------------------------------------------------------------------------
// Historique d'une notification (journal append-only) : création, planification, envoi, échec, annulation
// ----------------------------------------------------------------------------

model NotificationLog {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String               @db.Uuid
  event          NotificationLogEvent
  status         NotificationStatus? // statut de la notification APRÈS cet événement
  message        String? // précision lisible (motif d'échec, d'annulation…)
  attempt        Int? // numéro de tentative d'envoi concerné
  data           Json? // détails techniques (réponse du fournisseur : jamais de secret)
  adminId        String?              @db.Uuid // administrateur à l'origine ; vide = automatique
  createdAt      DateTime             @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  admin        Admin?       @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([notificationId, createdAt])
  @@index([createdAt])
  @@map("notification_logs")
}
